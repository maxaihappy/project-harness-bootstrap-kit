#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [[ $# -lt 2 ]]; then
  echo "Usage: bash scripts/generate-project <target-dir> <project-name> [display-name]" >&2
  exit 1
fi

TARGET_DIR="$1"
PROJECT_NAME="$2"
DISPLAY_NAME="${3:-$PROJECT_NAME}"

uv run python - "$TARGET_DIR" "$PROJECT_NAME" "$DISPLAY_NAME" <<'PY'
import sys
from pathlib import Path

from harness.generator.render import generate_project

root = Path.cwd()
target = Path(sys.argv[1]).resolve()
name = sys.argv[2]
display = sys.argv[3]
result = generate_project(root, target, name, display)
print(f"Generated project at {result.target} ({result.substituted_files} substituted files)")
PY
