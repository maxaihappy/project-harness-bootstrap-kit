#!/usr/bin/env bash
set -euo pipefail

# Scan tracked and untracked non-ignored files without staging or mutating Git state.
files=()
while IFS= read -r -d '' file; do
  files+=("$file")
done < <(git ls-files -z --cached --others --exclude-standard)

if ((${#files[@]} == 0)); then
  exit 0
fi

hook_args=(
  --baseline .secrets.baseline
  --exclude-files '^docs/validation/reviews/(h0-manus-review-5f772f2|h0-manus-rereview-19f6765|h0-manus-github-evidence-addendum-19f6765)\.md$'
)

uv run detect-secrets-hook "${hook_args[@]}" "${files[@]}"
