#!/usr/bin/env bash
set -euo pipefail

# Scan tracked and untracked non-ignored files without staging or mutating Git state.
files=()
while IFS= read -r -d '' file; do
  files+=("$file")
done < <(git ls-files -z --cached --others --exclude-standard)

if ((${#files[@]} == 0)); then
  exit 0
fi

uv run detect-secrets-hook --baseline .secrets.baseline "${files[@]}"
